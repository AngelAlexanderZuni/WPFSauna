<UserControl x:Class="ProyectoSauna.UserControlPago"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="#0F1115">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header del Módulo -->
        <Border Grid.Row="0" Background="#1A1D24" CornerRadius="8" Padding="20,15" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="CreditCard" Width="28" Height="28" Foreground="#4CC9F0" VerticalAlignment="Center"/>
                    <TextBlock Text="Módulo de Pagos y Comprobantes" FontSize="20" FontWeight="Bold" Foreground="White" Margin="15,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="2" Background="#FF6B3518" BorderBrush="#FF6B35" BorderThickness="1" CornerRadius="5" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#FF6B35" VerticalAlignment="Center"/>
                        <TextBlock Text="EN DESARROLLO" FontSize="11" FontWeight="Bold" Foreground="#FF6B35" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Contenido Principal -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel Izquierdo - Información de Cuenta -->
            <Border Grid.Column="0" Background="#1A1D24" CornerRadius="8" Margin="0,0,10,0" Padding="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Título del Panel -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="Receipt" Width="24" Height="24" Foreground="#22C55E" VerticalAlignment="Center"/>
                        <TextBlock Text="Información de la Cuenta" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Datos del Cliente -->
                    <Border Grid.Row="1" Background="#22272E" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ID Cuenta -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ID Cuenta:" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CuentaActual.idCuenta, TargetNullValue='-'}" Foreground="White" FontWeight="Medium" Margin="0,5"/>

                            <!-- Cliente -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Cliente:" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CuentaActual.ClienteNombre, TargetNullValue='-'}" Foreground="White" FontWeight="Medium" Margin="0,5"/>

                            <!-- Documento -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Documento:" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,5"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CuentaActual.ClienteDocumento, TargetNullValue='-'}" Foreground="White" FontWeight="Medium" Margin="0,5"/>

                            <!-- Descuento -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Descuento:" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,5"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CuentaActual.descuento, StringFormat='S/ {0:N2}', TargetNullValue='-'}" Foreground="#FF6B35" FontWeight="Bold" Margin="0,5"/>
                        </Grid>
                    </Border>

                    <!-- Detalles de Consumo (Nuevo) -->
                    <Grid Grid.Row="2" Margin="0,0,0,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="Detalle de Consumos" FontSize="14" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,0,0,10"/>
                        
                        <DataGrid Grid.Row="1" ItemsSource="{Binding DetallesCuenta}" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  HeadersVisibility="Column"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#333842">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}" BorderThickness="0">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#2A303C"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#333842"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*"/>
                                <DataGridTextColumn Header="TIPO" Binding="{Binding Tipo}" Width="Auto"/>
                                <DataGridTextColumn Header="CANT." Binding="{Binding Cantidad}" Width="Auto"/>
                                <DataGridTextColumn Header="P.UNIT" Binding="{Binding PrecioUnitario, StringFormat='S/ {0:N2}'}" Width="Auto"/>
                                <DataGridTextColumn Header="TOTAL" Binding="{Binding Subtotal, StringFormat='S/ {0:N2}'}" Width="Auto" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Total a Pagar -->
                    <Border Grid.Row="3" Background="#22C55E18" BorderBrush="#22C55E" BorderThickness="2" CornerRadius="8" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Grid.Column="0" Kind="CashMultiple" Width="32" Height="32" Foreground="#22C55E" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Total a Pagar" FontSize="14" Foreground="#9CA3AF" FontWeight="Medium"/>
                                <TextBlock Text="{Binding TotalPagarDisplay, TargetNullValue='-'}" FontSize="24" FontWeight="Bold" Foreground="#22C55E"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Panel Derecho - Maqueta de Métodos de Pago -->
            <Border Grid.Column="1" Background="#1A1D24" CornerRadius="8" Margin="10,0,0,0" Padding="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Título del Panel -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="Payment" Width="24" Height="24" Foreground="#4CC9F0" VerticalAlignment="Center"/>
                        <TextBlock Text="Métodos de Pago" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Indicador de Estado -->
                    <Border Grid.Row="0" Background="#333741" CornerRadius="4" Padding="10,8" Margin="0,50,0,15">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Information" Width="16" Height="16" Foreground="#4CC9F0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MensajeEstado}" FontSize="12" Foreground="#9CA3AF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Métodos de Pago (ListBox) -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding MetodosPago}" 
                             SelectedItem="{Binding MetodoPagoSeleccionado}"
                             Margin="0,0,0,20" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0" CornerRadius="6" Margin="0,0,0,10">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <!-- Visual effect controlled by inner Border in ItemTemplate logic or here -->
                                                    <!-- But simpler to just let the item template handle the visual state via binding mechanism or just simple color change here -->
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#2A303C"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#22272E" CornerRadius="6" Padding="15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <materialDesign:PackIcon Grid.Column="0" Kind="CreditCard" Width="20" Height="20" Foreground="#4CC9F0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding nombre}" FontSize="14" Foreground="White" FontWeight="Medium" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        
                                        <!-- Selection Indicator using Binding to RelativeSource Ancestor's IsSelected is tricky in DataTemplate without FindAncestor -->
                                        <!-- Simpler: Just rely on ListBox selection highlight logic if possible, or omit the RadioButton for a simple border highlight -->
                                        <!-- Or use RelativeSource to check IsSelected of ListBoxItemContainer -->
                                        <RadioButton Grid.Column="2" IsHitTestVisible="False" 
                                                     IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                     Style="{StaticResource MaterialDesignRadioButton}" BorderBrush="#4CC9F0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Botones de Acción -->
                    <StackPanel Grid.Row="2">
                        <!-- Indicador de Progreso -->
                        <ProgressBar x:Name="PaymentProgressBar" 
                                   IsIndeterminate="{Binding IsBusy}" 
                                   Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Height="4" Margin="0,0,0,10" 
                                   Background="#333" Foreground="#4CC9F0"/>
                        
                        <Button Style="{StaticResource MaterialDesignRaisedButton}" 
                               Command="{Binding ProcesarPagoCommand}"
                               Background="#22C55E" Foreground="White" 
                               Height="45" FontWeight="Bold" FontSize="14"
                               Margin="0,0,0,10"
                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                            <Button.Content>
                                <Grid>
                                    <!-- Estado Normal -->
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                        <materialDesign:PackIcon Kind="Check" Width="20" Height="20" VerticalAlignment="Center"/>
                                        <TextBlock Text="PROCESAR PAGO" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <!-- Estado Cargando -->
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <materialDesign:PackIcon Kind="Loading" Width="20" Height="20" VerticalAlignment="Center">
                                            <materialDesign:PackIcon.RenderTransform>
                                                <RotateTransform x:Name="LoadingRotation"/>
                                            </materialDesign:PackIcon.RenderTransform>
                                            <materialDesign:PackIcon.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetName="LoadingRotation" 
                                                                           Storyboard.TargetProperty="Angle" 
                                                                           From="0" To="360" Duration="0:0:1"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </materialDesign:PackIcon.Triggers>
                                        </materialDesign:PackIcon>
                                        <TextBlock Text="PROCESANDO..." Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Button.Content>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}" 
                               Command="{Binding VolverCommand}"
                               BorderBrush="#6B7280" Foreground="#6B7280" 
                               Height="40" FontWeight="Medium"
                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Volver a Cuentas" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>