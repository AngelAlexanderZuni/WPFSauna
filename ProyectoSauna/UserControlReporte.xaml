<UserControl x:Class="ProyectoSauna.UserControlReporte"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#14161C">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <materialDesign:PackIcon Kind="ChartBoxOutline" Width="40" Height="40" Foreground="#4CC9F0"/>
            <StackPanel>
                <TextBlock Text="Reportes y Dashboard" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="Ingresos, Egresos, Productos, Clientes" FontSize="12" Foreground="#9CA3AF"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,16,0,8">
            <TextBlock Text="Inicio:" VerticalAlignment="Center" Foreground="White"/>
            <DatePicker SelectedDate="{Binding FechaInicio, Mode=TwoWay}" Margin="8,0,0,0"/>
            <TextBlock Text="Fin:" VerticalAlignment="Center" Foreground="White" Margin="8,0,0,0"/>
            <DatePicker SelectedDate="{Binding FechaFin, Mode=TwoWay}"/>
            <Button Content="Generar" Command="{Binding GenerarReporteCommand}" Margin="8,0,0,0"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ingresos por día" Foreground="#9CA3AF"/>
            <DataGrid Grid.Row="1" Grid.Column="0" ItemsSource="{Binding ListaIngresos}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat={}{0:dd/MM}}" Width="140"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:C}}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Egresos del mes" Foreground="#9CA3AF" Margin="0,8,0,0"/>
            <DataGrid Grid.Row="3" Grid.Column="0" ItemsSource="{Binding ListaEgresos}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding TipoEgreso}" Width="*"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:C}}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="0" Grid.Column="1" Text="Top Productos" Foreground="#9CA3AF"/>
            <DataGrid Grid.Row="1" Grid.Column="1" ItemsSource="{Binding TopProductos}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="*"/>
                    <DataGridTextColumn Header="Unidades" Binding="{Binding CantidadVendida}" Width="120"/>
                    <DataGridTextColumn Header="Ingresos" Binding="{Binding IngresosGenerados, StringFormat={}{0:C}}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2" Grid.Column="1" Text="Mejores Clientes" Foreground="#9CA3AF" Margin="0,8,0,0"/>
            <DataGrid Grid.Row="3" Grid.Column="1" ItemsSource="{Binding MejoresClientes}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Cliente" Binding="{Binding NombreCompleto}" Width="*"/>
                    <DataGridTextColumn Header="Visitas" Binding="{Binding Visitas}" Width="100"/>
                    <DataGridTextColumn Header="Gastado" Binding="{Binding TotalGastado, StringFormat={}{0:C}}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="Flujo de Caja (mes de fin)" Foreground="#9CA3AF" Margin="0,8,0,0"/>
            <UniformGrid Grid.Row="5" Grid.ColumnSpan="2" Rows="1" Columns="3" Margin="0,4,0,0">
                <Border Padding="16" Margin="4" Background="#1F2430" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Ingresos" Foreground="#9CA3AF"/>
                        <TextBlock Text="{Binding FlujoCaja.TotalIngresos, StringFormat={}{0:C}}" FontSize="20" FontWeight="SemiBold" Foreground="#4CAF50"/>
                    </StackPanel>
                </Border>
                <Border Padding="16" Margin="4" Background="#1F2430" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Egresos" Foreground="#9CA3AF"/>
                        <TextBlock Text="{Binding FlujoCaja.TotalEgresos, StringFormat={}{0:C}}" FontSize="20" FontWeight="SemiBold" Foreground="#EF4444"/>
                    </StackPanel>
                </Border>
                <Border Padding="16" Margin="4" Background="#1F2430" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Utilidad" Foreground="#9CA3AF"/>
                        <TextBlock Text="{Binding FlujoCaja.UtilidadNeta, StringFormat={}{0:C}}" FontSize="20" FontWeight="SemiBold" Foreground="#60A5FA"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Grid>
    </Grid>
</UserControl>
