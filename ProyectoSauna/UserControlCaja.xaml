<UserControl x:Class="ProyectoSauna.UserControlCaja"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#14161C">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <materialDesign:PackIcon Kind="CashRegister" Width="40" Height="40" Foreground="#4CC9F0"/>
            <StackPanel>
                <TextBlock Text="Caja / Flujo Diario" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="Administra ingresos y egresos por fecha" FontSize="12" Foreground="#9CA3AF"/>
            </StackPanel>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,16,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="Fecha:" VerticalAlignment="Center" Foreground="White"/>
                <DatePicker SelectedDate="{Binding FechaSeleccionada, Mode=TwoWay}" Margin="8,0,0,0"/>
                <Button Content="Hoy" Command="{Binding HoyCommand}" Margin="8,0,0,0"/>
                <Button Content="Actualizar" Command="{Binding CargarMovimientosCommand}" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding IsLoading, StringFormat= Cargando: {0}}" Foreground="#9CA3AF" HorizontalAlignment="Right"/>
        </DockPanel>

        <UniformGrid Grid.Row="2" Rows="1" Columns="3" Margin="0,8,0,12">
            <Border Padding="16" Margin="4" Background="#1F2430" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Total Ingresos" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding TotalIngresos, StringFormat={}{0:C}}" FontSize="20" FontWeight="SemiBold" Foreground="#4CAF50"/>
                </StackPanel>
            </Border>
            <Border Padding="16" Margin="4" Background="#1F2430" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Total Egresos" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding TotalEgresos, StringFormat={}{0:C}}" FontSize="20" FontWeight="SemiBold" Foreground="#EF4444"/>
                </StackPanel>
            </Border>
            <Border Padding="16" Margin="4" Background="#1F2430" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Balance" Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding Balance, StringFormat={}{0:C}}" FontSize="20" FontWeight="SemiBold" Foreground="#60A5FA"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DataGrid ItemsSource="{Binding Movimientos}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      Margin="0,8,0,0"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None">
                <DataGrid.Resources>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#14161C"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Path=FechaHora, StringFormat={}{0:dd/MM HH:mm}}" Width="140"/>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="100"/>
                    <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="*"/>
                    <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="140"/>
                    <DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat={}{0:C}}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>