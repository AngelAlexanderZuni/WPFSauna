
    
    
    <UserControl x:Class="ProyectoSauna.UserControlEgresos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:ProyectoSauna.ViewModels"
             xmlns:conv="clr-namespace:ProyectoSauna.Converters"
             Background="#0F1115">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <conv:BoolToIconConverter x:Key="BoolToIconConverter"/>

        <!-- Estilos consistentes con el sistema -->
        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="#4CC9F0"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <Style TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:EgresosViewModel/>
    </UserControl.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1A1D24" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="CashMinus" Width="20" Height="20" Foreground="#4CC9F0" VerticalAlignment="Center"/>
                    <TextBlock Text="Gestión de Egresos" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" 
                            Command="{Binding NuevoEgresoCommand}" 
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16"/>
                            <TextBlock Text="Nuevo" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Style="{StaticResource PrimaryButton}" 
                            Command="{Binding GuardarCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16"/>
                            <TextBlock Text="Guardar" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>
                    
                    <Border Background="#DC2626" CornerRadius="6" Margin="8,0,0,0">
                        <Button Background="Transparent" Foreground="White" BorderThickness="0" 
                                Padding="12,6" Command="{Binding CancelarCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cancel" Width="16" Height="16"/>
                                <TextBlock Text="Cancelar" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido Principal -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel Izquierdo - Datos de Cabecera y Detalle -->
            <Border Grid.Column="0" Background="#1A1D24" CornerRadius="6" Padding="16" Margin="0,0,4,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Datos de Cabecera -->
                        <TextBlock Text="📄 Datos de la Cabecera" 
                                 FontSize="14" FontWeight="SemiBold" 
                                 Foreground="#4CC9F0" Margin="0,0,0,12"/>
                        
                        <!-- Fecha Egreso -->
                        <TextBlock Text="Fecha de Egreso" Foreground="#A0A9B8" FontSize="11" Margin="0,0,0,4"/>
                        <DatePicker x:Name="dpFechaEgreso" 
                                  SelectedDate="{Binding CabeceraEgreso.fecha, Mode=TwoWay}"
                                  Margin="0,0,0,12"/>
                        
                        <!-- Monto Total -->
                        <TextBlock Text="TOTAL EGRESO" Foreground="#4CC9F0" FontSize="13" FontWeight="Bold" Margin="0,8,0,4"/>
                        <Border Background="#22C55E18" BorderBrush="#22C55E" BorderThickness="1" 
                               CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                            <TextBlock Text="{Binding TotalEgresoFormateado}" 
                                     FontSize="18" FontWeight="Bold" 
                                     Foreground="#22C55E" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Detalle del Egreso -->
                        <TextBlock Text="📝 Detalle del Egreso" 
                                 FontSize="14" FontWeight="SemiBold" 
                                 Foreground="#4CC9F0" Margin="0,16,0,12"/>
                        
                        <!-- Concepto del gasto -->
                        <TextBlock Text="Concepto del gasto" Foreground="#A0A9B8" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtConcepto" 
                               Text="{Binding ConceptoDetalle, Mode=TwoWay}"
                               Margin="0,0,0,12"/>
                        
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Monto -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Monto" Foreground="#A0A9B8" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding MontoDetalle, Mode=TwoWay}"/>
                            </StackPanel>
                            
                            <!-- Tipo de Egreso -->
                            <StackPanel Grid.Column="2">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Tipo de Egreso" Foreground="#A0A9B8" FontSize="11"/>
                                    <Border Grid.Column="1" Background="#22C55E" CornerRadius="3" Margin="4,0,0,0">
                                        <Button Background="Transparent" Foreground="White" BorderThickness="0" 
                                               Padding="4,2" Command="{Binding NuevoTipoEgresoCommand}"
                                               ToolTip="Agregar nuevo tipo de egreso">
                                            <materialDesign:PackIcon Kind="Plus" Width="10" Height="10"/>
                                        </Button>
                                    </Border>
                                </Grid>
                                <ComboBox ItemsSource="{Binding TiposEgreso}"
                                        DisplayMemberPath="nombre"
                                        SelectedValuePath="idTipoEgreso"
                                        SelectedValue="{Binding TipoEgresoSeleccionadoId, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Egreso recurrente -->
                        <CheckBox Content="Egreso recurrente" 
                                IsChecked="{Binding EsRecurrenteDetalle, Mode=TwoWay}"
                                Foreground="White" Margin="0,8,0,16"/>

                        <!-- Comprobante -->
                        <TextBlock Text="📎 Comprobante" 
                                 FontSize="14" FontWeight="SemiBold" 
                                 Foreground="#4CC9F0" Margin="0,16,0,12"/>
                                 
                        <Border Background="#7C3AED18" BorderBrush="#7C3AED" BorderThickness="1" 
                               CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <!-- Estado del archivo -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                          Visibility="{Binding RutaComprobante, Converter={StaticResource NullToVisibilityConverter}}">
                                    <materialDesign:PackIcon Kind="CheckCircle" Foreground="#22C55E" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="Archivo seleccionado" Foreground="#22C55E" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Column="0" Background="#7C3AED" CornerRadius="4">
                                        <Button Background="Transparent" Foreground="White" 
                                               BorderThickness="0" Padding="8,4" 
                                               Command="{Binding SeleccionarComprobanteCommand}"
                                               HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Upload" Width="14" Height="14"/>
                                                <TextBlock Text="Seleccionar Archivo (PDF, JPG, PNG)" Margin="4,0,0,0" FontSize="10"/>
                                            </StackPanel>
                                        </Button>
                                    </Border>
                                    
                                    <Border Grid.Column="1" Background="#059669" CornerRadius="4" Margin="4,0,0,0"
                                           Visibility="{Binding RutaComprobante, Converter={StaticResource NullToVisibilityConverter}}">
                                        <Button Background="Transparent" Foreground="White" 
                                               BorderThickness="0" Padding="8,4" 
                                               Command="{Binding VerComprobanteCommand}">
                                            <materialDesign:PackIcon Kind="Eye" Width="14" Height="14"/>
                                        </Button>
                                    </Border>
                                    
                                    <Border Grid.Column="2" Background="#DC2626" CornerRadius="4" Margin="4,0,0,0"
                                           Visibility="{Binding RutaComprobante, Converter={StaticResource NullToVisibilityConverter}}">
                                        <Button Background="Transparent" Foreground="White" 
                                               BorderThickness="0" Padding="8,4" 
                                               Command="{Binding EliminarComprobanteCommand}">
                                            <materialDesign:PackIcon Kind="Delete" Width="14" Height="14"/>
                                        </Button>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                        
                        <Border Background="#059669" CornerRadius="6" Margin="0,16,0,0">
                            <Button Background="Transparent" Foreground="White" BorderThickness="0" 
                                   Padding="12,8" Command="{Binding AgregarDetalleCommand}"
                                   HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16"/>
                                    <TextBlock Text="Agregar Detalle al Egreso" Margin="8,0,0,0" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Panel Derecho - Detalles y Historial -->
            <Grid Grid.Column="1" Margin="4,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Detalles del Egreso -->
                <Border Grid.Row="0" Background="#1A1D24" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <materialDesign:PackIcon Grid.Column="0" Kind="FormatListBulleted" 
                                                   Width="16" Height="16" Foreground="#4CC9F0" 
                                                   VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Detalles del Egreso" 
                                     FontSize="14" FontWeight="SemiBold" 
                                     Foreground="#4CC9F0" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" 
                                     Text="{Binding DetallesEgreso.Count, StringFormat='({0} detalles)'}" 
                                     FontSize="11" Foreground="#A0A9B8" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <DataGrid ItemsSource="{Binding DetallesEgreso}"
                                SelectedItem="{Binding DetalleSeleccionado}"
                                Background="Transparent"
                                Foreground="White"
                                GridLinesVisibility="None"
                                HeadersVisibility="Column"
                                CanUserAddRows="False"
                                AutoGenerateColumns="False"
                                RowBackground="#22252D"
                                AlternatingRowBackground="#1E2128">
                            
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Concepto" Binding="{Binding concepto}" Width="*"/>
                                <DataGridTextColumn Header="Monto" Binding="{Binding monto, StringFormat=C}" Width="80"/>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding TipoEgreso.nombre}" Width="80"/>
                                <DataGridTemplateColumn Header="Rec." Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <materialDesign:PackIcon Kind="{Binding recurrente, Converter={StaticResource BoolToIconConverter}}" 
                                                                   Width="14" Height="14" 
                                                                   Foreground="#4CC9F0" 
                                                                   HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Acciones" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Border Background="#3B82F6" CornerRadius="3" Margin="0,0,4,0">
                                                    <Button Background="Transparent" Foreground="White" 
                                                           BorderThickness="0" Padding="4" 
                                                           Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.EditarDetalleCommand}"
                                                           CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="Pencil" Width="12" Height="12"/>
                                                    </Button>
                                                </Border>
                                                <Border Background="#DC2626" CornerRadius="3">
                                                    <Button Background="Transparent" Foreground="White" 
                                                           BorderThickness="0" Padding="4" 
                                                           Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.EliminarDetalleCommand}"
                                                           CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="Delete" Width="12" Height="12"/>
                                                    </Button>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Historial de Egresos -->
                <Border Grid.Row="2" Background="#1A1D24" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <materialDesign:PackIcon Grid.Column="0" Kind="History" 
                                                   Width="16" Height="16" Foreground="#4CC9F0" 
                                                   VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Historial de Egresos" 
                                     FontSize="14" FontWeight="SemiBold" 
                                     Foreground="#4CC9F0" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <DataGrid ItemsSource="{Binding HistorialEgresos}"
                                SelectedItem="{Binding EgresoSeleccionado}"
                                Background="Transparent"
                                Foreground="White"
                                GridLinesVisibility="None"
                                HeadersVisibility="Column"
                                CanUserAddRows="False"
                                AutoGenerateColumns="False"
                                RowBackground="#22252D"
                                AlternatingRowBackground="#1E2128">
                            
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding fecha, StringFormat=dd/MM/yyyy}" Width="80"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding montoTotal, StringFormat=C}" Width="*"/>
                                <DataGridTemplateColumn Header="Acciones" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#7C3AED" CornerRadius="4">
                                                <Button Background="Transparent" Foreground="White" 
                                                       BorderThickness="0" Padding="6,4" 
                                                       Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.CargarEgresoCommand}"
                                                       CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="Download" Width="12" Height="12"/>
                                                </Button>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>