<UserControl x:Class="ProyectoSauna.UserControlComprobantes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="#0F1115">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding CargarComprobantesCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1A1D24" CornerRadius="8" Padding="20,15" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignIconButton}" 
                            Command="{Binding VolverCommand}"
                            Foreground="#9CA3AF" Margin="0,0,15,0"
                            ToolTip="Volver a Pagos">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="24" Height="24"/>
                    </Button>
                    <materialDesign:PackIcon Kind="History" Width="28" Height="28" Foreground="#4CC9F0" VerticalAlignment="Center"/>
                    <TextBlock Text="Historial de Comprobantes" FontSize="20" FontWeight="Bold" Foreground="White" Margin="15,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Status/Date Range could go here -->
            </Grid>
        </Border>

        <!-- List -->
        <Border Grid.Row="1" Background="#1A1D24" CornerRadius="8" Padding="20">
            <DataGrid ItemsSource="{Binding Comprobantes}" 
                      SelectedItem="{Binding SelectedComprobante}"
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      Background="Transparent"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#333842">
                
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#9CA3AF"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" BorderThickness="0">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2A303C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#333842"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="FECHA" Binding="{Binding fechaEmision, StringFormat=dd/MM/yyyy HH:mm}" Width="*"/>
                    <DataGridTextColumn Header="TIPO" Binding="{Binding TipoComprobanteNombre}" Width="Auto"/>
                    <DataGridTextColumn Header="SERIE" Binding="{Binding serie}" Width="Auto"/>
                    <DataGridTextColumn Header="NÚMERO" Binding="{Binding numero}" Width="Auto"/>
                    <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding subtotal, StringFormat='S/ {0:N2}'}" Width="Auto"/>
                    <DataGridTextColumn Header="TOTAL" Binding="{Binding total, StringFormat='S/ {0:N2}'}" Width="Auto" FontWeight="Bold"/>
                    
                    <DataGridTemplateColumn Header="ACCIONES" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding DataContext.VerDetalleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="Ver Detalles">
                                        <materialDesign:PackIcon Kind="Eye" Foreground="#4CC9F0"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding DataContext.ImprimirCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="Imprimir Comprobante">
                                        <materialDesign:PackIcon Kind="Printer" Foreground="#22C55E"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

         <!-- Details Overlay -->
        <Border Grid.RowSpan="2" Background="#CC000000" 
                Visibility="{Binding IsDetailsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="600" Height="500" Background="#1A1D24" CornerRadius="8" Padding="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Overlay Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <Grid Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ReceiptText" Width="24" Height="24" Foreground="#FF6B35" VerticalAlignment="Center"/>
                                <TextBlock Text="Detalle del Comprobante" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Style="{StaticResource MaterialDesignIconButton}" Command="{Binding CerrarDetalleCommand}" Foreground="White">
                                <materialDesign:PackIcon Kind="Close"/>
                            </Button>
                        </Grid>

                        <Border Background="#2A303C" CornerRadius="4" Padding="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding SelectedComprobante.TipoComprobanteNombre, TargetNullValue='Tipo Desconocido'}" FontWeight="Bold" Foreground="#4CC9F0" FontSize="16"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding SelectedComprobante.serie}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text=" - " Foreground="White" FontSize="14"/>
                                        <TextBlock Text="{Binding SelectedComprobante.numero}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedComprobante.fechaEmision, StringFormat='Fecha: {0:dd/MM/yyyy HH:mm}'}" Foreground="#9CA3AF" FontSize="13" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SelectedComprobante.NombreCliente, TargetNullValue='Cliente Desconocido'}" FontWeight="SemiBold" Foreground="White" FontSize="14" TextAlignment="Right"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                        <materialDesign:PackIcon Kind="CardAccountDetails" Width="14" Height="14" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding SelectedComprobante.DocumentoCliente, TargetNullValue='N/A'}" Foreground="White" FontSize="13"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Details List -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding DetallesConsumo}" 
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HorizontalGridLinesBrush="#333842"
                              BorderThickness="0" Background="Transparent"
                              HeadersVisibility="Column">
                        
                        <!-- Reusing resources from main grid for consistency -->
                         <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                             <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                             <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#333842"/>
                            </Style>
                        </DataGrid.Resources>
                        
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*"/>
                            <DataGridTextColumn Header="TIPO" Binding="{Binding Tipo}" Width="Auto"/>
                            <DataGridTextColumn Header="CANT." Binding="{Binding Cantidad}" Width="Auto"/>
                            <DataGridTextColumn Header="PRECIO" Binding="{Binding PrecioUnitario, StringFormat='S/ {0:N2}'}" Width="Auto"/>
                            <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding Subtotal, StringFormat='S/ {0:N2}'}" Width="Auto" FontWeight="Bold"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Overlay Footer -->
                     <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                         <TextBlock Text="Total:" Foreground="#9CA3AF" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                         <TextBlock Text="{Binding SelectedComprobante.total, StringFormat='S/ {0:N2}'}" Foreground="#22C55E" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                     </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
